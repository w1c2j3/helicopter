[Unit]
Description=Helicopter famous120-v1 native LightEval naive CoT queue
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/rwkv/chase/helicopter
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/rwkv/.local/bin/uv run helicopter eval batch --config configs/releases/famous120-v1-naive-cot.toml --env-file .env.remote --models g1h-1.5b,g1h-2.9b,g1h-7.2b,g1h-13.3b --tasks mmlu_pro,gpqa:diamond,gpqa:main,hle,simpleqa,triviaqa,natural_questions,truthfulqa:mc,arc:challenge,openbookqa,commonsenseqa,hellaswag,piqa,siqa,pubmedqa,med_qa,med_mcqa,aime25,aime24,math_500,hendrycks_math,gsm8k,gsm_plus,omni_math,amc23,college_math,agieval:aqua-rat,mathqa,svamp,asdiv,mawps --output-dir /tmp/helicopter-famous120-v1-naive-cot --no-server --scoreboard --max-retries 2
Restart=on-failure
RestartSec=30
TimeoutStopSec=300
KillMode=mixed

[Install]
WantedBy=default.target
