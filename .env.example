# Keep this file in simple dotenv syntax: KEY=VALUE or export KEY=VALUE.
# Do not use shell expressions if the Python CLI must read the same file.
REMOTE_WORKSPACE_ID=workspace
REMOTE_NAMESPACE=default
REMOTE_POD=replace-with-pod-name
REMOTE_NODE=replace-with-node-name
REMOTE_IMAGE=replace-with-container-image
DEVPOD_SEED_IMAGE=nvcr.io/nvidia/cuda:13.2.1-cudnn-devel-ubuntu24.04
DEVPOD_HOME=/home/<user>/.devpod
DEVPOD_SOURCE=/home/<user>/.devpod/manual-sources/workspace
DEVPOD_POD_TEMPLATE=/home/<user>/.devpod/manual-sources/pod-template.yaml
REMOTE_SSH_HOST=workspace.devpod
REMOTE_ROOT=/workspace/helicopter
REMOTE_VENV=/workspace/helicopter/.venv
PYTHON_VERSION=3.12
INSTALL_COMPONENTS=rwkv-lm,vllm-rwkv,verl-rwkv,lighteval,lm-eval,dev
UPDATE_UV=0
# 0 = require current locks; lock = refresh locks without broad upgrades; 1 = broad upgrade.
UV_UPGRADE=0
RUN_PIP_CHECK=1
UV_SYNC_INEXACT=1
VLLM_TARGET_DEVICE=cuda
VLLM_USE_PRECOMPILED=0
VLLM_REBUILD=auto
VERL_REINSTALL=auto
CMAKE_BUILD_TYPE=RelWithDebInfo
BUILD_TMPDIR=.tmp
REMOTE_HTTP_PROXY=
REMOTE_HTTPS_PROXY=
REMOTE_NO_PROXY=localhost,127.0.0.1,::1
PYPI_INDEX_URL=https://pypi.org/simple
UV_INDEX_URL=https://pypi.org/simple
HF_ENDPOINT=
UV_LINK_MODE=copy
UV_CACHE_DIR=.tmp/cache/uv
PRE_COMMIT_HOME=.tmp/cache/pre-commit
CARGO_REGISTRY_MIRROR=
DEVPOD_RECREATE=0
SYNC_REMOTE=1
INSTALL_REMOTE=1

HELICOPTER_VENV=.venv
HELICOPTER_VERL_PATH=src/train/verl-rwkv
RWKV_LM_PATH=src/train/rwkv-lm
HELICOPTER_VLLM_RWKV_PATH=src/infer/vllm-rwkv

WEIGHT_PATH=/workspace/weights
DATASETS_PATH=/workspace/datasets
# LightEval publication is mandatory. Keep the real token only in .env.local
# or .env.remote.
HELICOPTER_SCOREBOARD_URL=https://scoreboard.example.test
HELICOPTER_SCOREBOARD_TOKEN=replace-with-private-token
HELICOPTER_EVAL_STAGING_ROOT=/workspace/helicopter/.tmp/eval

PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
